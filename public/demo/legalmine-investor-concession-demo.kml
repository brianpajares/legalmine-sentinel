<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>LegalMine Sentinel - Investor Concession Demo AOI</name>
    <description>
      Predefined area of interest for demonstrating LegalMine Sentinel's mining-concession screening workflow in Peru.
      This file only defines the AOI. Official findings must be generated by the application against configured sources.
    </description>
    <Style id="aoiStyle">
      <LineStyle>
        <color>ffffffff</color>
        <width>3</width>
      </LineStyle>
      <PolyStyle>
        <color>26ffffff</color>
      </PolyStyle>
    </Style>
    <Placemark>
      <name>Investor Demo AOI - Concession Screening</name>
      <description>
        Use this polygon to show the concession, REINFO, environmental, water, territorial and evidence-map workflow.
      </description>
      <styleUrl>#aoiStyle</styleUrl>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              -69.860000,-12.900000,0
              -69.820000,-12.900000,0
              -69.820000,-12.930000,0
              -69.860000,-12.930000,0
              -69.860000,-12.900000,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
  </Document>
</kml>
