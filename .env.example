# LegalMine Sentinel — deployment configuration
#
# Copy to .env.local and fill in what you have verified. Every value is optional:
# with none of them set the app still runs, reports every connector as
# NOT_CONFIGURED, and produces a NOT_ASSESSED result. That is correct behaviour,
# not a failure — the product never invents a value to fill a gap.
#
# Discover the exact ArcGIS layer URLs with:  npm run sources:probe
# Confirm them with:                          curl -s localhost:3000/api/health/sources | jq

# ---------------------------------------------------------------------------
# P0 — official sources. An assessment is COMPLETED only when both answer.
# ---------------------------------------------------------------------------

# INGEMMET mining cadastre (GEOCATMIN). Full ArcGIS layer URL, ending in /MapServer/<n>.
INGEMMET_LAYER_URL=

# Optional attribute remapping, if the layer schema differs from the defaults.
# INGEMMET_FIELD_CODE=CODIGOU
# INGEMMET_FIELD_NAME=CONCESION
# INGEMMET_FIELD_STATUS=ESTADO
# INGEMMET_FIELD_HOLDER=TITULAR
# INGEMMET_FIELD_SUBSTANCE=SUSTANCIA
# INGEMMET_FIELD_HECTARES=HECTA

# SERNANP protected areas (Geo ANP). Full ArcGIS layer URL.
SERNANP_LAYER_URL=

# SERNANP_FIELD_NAME=ANP_NOMB
# SERNANP_FIELD_CATEGORY=ANP_CATEG
# SERNANP_FIELD_NORM=D_S
# SERNANP_FIELD_DATE=FECHA

# ---------------------------------------------------------------------------
# P1/P2 — optional sources
# ---------------------------------------------------------------------------

# MINEM REINFO. Leave EMPTY unless a stable official interface has been confirmed.
# With this unset the adapter reports MANUAL_VERIFICATION_REQUIRED and never scrapes.
REINFO_API_URL=

# Copernicus Data Space — Sentinel-2 L2A scene search (metadata only).
COPERNICUS_ENABLED=false
# COPERNICUS_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac

# Ministry of Culture BDPI — territorial context layer.
BDPI_LAYER_URL=

# ANA / SNIRH — water resources layer.
ANA_LAYER_URL=

# Per-request timeout for any outbound source call, in milliseconds.
# SOURCE_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Storage — without these, projects and assessments live in memory and are lost
# on restart, which makes dossiers non-reproducible.
# Apply supabase/migrations/0001_init.sql first.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Demo mode — enables the clearly watermarked fixture path. It never changes how
# a real source is reported, and it never simulates REINFO or satellite imagery.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Analytics — events are sent only when a key is present. There is no local
# fallback that pretends to record analytics.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Billing — self-serve checkout activates per plan once its price ID is set.
# Until then the pricing page records a lead and routes to a conversation.
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_TEAM=

# Absolute URL of the deployment, used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=
